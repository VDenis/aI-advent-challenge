# ===========================================
# Telegram Bot Configuration
# ===========================================

# REQUIRED: Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ===========================================
# LLM Engine Configuration
# ===========================================

# Choose LLM engine: "ollama" (default) or "llamacpp"
LLM_ENGINE=ollama

# --- Ollama Settings ---
# Base URL for Ollama API (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Default model to use (default: qwen3:4b)
# Popular models: qwen3:4b, llama3.2, mistral, gemma2, phi3
OLLAMA_MODEL=qwen3:4b

# --- llama.cpp Settings ---
# Path to GGUF model file (required if LLM_ENGINE=llamacpp)
LLAMACPP_MODEL_PATH=/path/to/model.gguf

# Path to llama-cli executable (default: llama-cli)
LLAMACPP_CLI_PATH=llama-cli

# Context size (default: 4096)
LLAMACPP_N_CTX=4096

# Max tokens to predict (default: 512)
LLAMACPP_N_PREDICT=512

# ===========================================
# Dialog History Settings
# ===========================================

# Max messages to keep in history per chat (default: 20)
MAX_HISTORY_MESSAGES=20

# Max response tokens (default: 1024)
MAX_RESPONSE_TOKENS=1024

# ===========================================
# System Settings
# ===========================================

# LLM request timeout in seconds (default: 120)
LLM_TIMEOUT=120

# Number of retries on LLM errors (default: 2)
LLM_RETRIES=2

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# ===========================================
# Custom System Prompt (optional)
# ===========================================

# SYSTEM_PROMPT=You are a helpful assistant...
