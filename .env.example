# GitHub Token (для доступа к PR)
# Получить можно здесь: https://github.com/settings/tokens
# Нужны права: repo (read), pull_requests (write)
GITHUB_TOKEN=ghp_your_token_here

# GigaChat Credentials (Base64 encoded)
# Формат: base64(client_id:client_secret)
# Пример кодирования: echo -n "client_id:client_secret" | base64
GIGACHAT_CREDENTIALS=your_base64_credentials_here

# Опционально: путь к проекту (по умолчанию текущая директория)
PROJECT_ROOT=/Users/denis/code/ai_challenge/aI-advent-challenge

# Для тестирования конкретного PR
# PR_NUMBER=123
# GITHUB_REPO=owner/repo
