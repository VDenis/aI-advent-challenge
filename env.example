### Weather MCP demo (GigaChat + Open-Meteo)
GIGACHAT_CREDENTIALS=base64(client_id:client_secret)
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL_CERTS=false

### GigaChat console clients (cli/)
GIGA_CLIENT_BASIC=base64(client_id:client_secret)
GIGA_API_BASE_URL=https://gigachat.devices.sberbank.ru
GIGA_VERIFY_SSL=true
GIGA_MODEL_NAME=GigaChat

### Hugging Face (bots/hf_demo, cli/hf_cli.py, cli/hf_llama3_openai.py)
HF_TOKEN=hf_your_token_here
HF_BOT_TOKEN=telegram_bot_token_here
